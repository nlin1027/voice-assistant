# ─── Secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example
!bot/client/env.example
*.pem
*.key

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Virtual environments ───────────────────────────────────
# The real venv lives outside the repo (see CLAUDE.md), but guard
# against one being created in-tree by accident — an in-project
# .venv breaks the pipecat CLI via nltk's inisec.py CWD check.
.venv/
venv/
env/
ENV/

# ─── Tooling caches ─────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# ─── Node.js (client/) ───────────────────────────────────────
# bot/client/.gitignore already covers this within client/, but
# repeat the important ones at the root as a safety net in case
# node_modules ever gets created/run from somewhere else.
node_modules/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Broker: task store ─────────────────────────────────────
broker/tasks.db
broker/tasks.db-journal
broker/tasks.db-wal
broker/tasks.db-shm

# ─── Hermes task workspaces ─────────────────────────────────
# Every dispatched task gets its own directory here holding
# result.md, usage.json, and whatever files the task produced.
# Keep the workspace rules, ignore the run artifacts.
hermes-tasks/*
!hermes-tasks/AGENTS.md
!hermes-tasks/.gitkeep

# ─── Logs & eval run artifacts ───────────────────────────────
*.log
eval-runs/

# ─── Editors / OS ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude Code local state ─────────────────────────────────
# .claude/launch.json is shared project config (dev server launch
# entries) and is meant to be tracked. Only ignore personal/local
# overrides, which don't exist yet but will land here if created.
.claude/settings.local.json
