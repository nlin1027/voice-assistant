# ─── Secrets ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ─── Virtual environments ───────────────────────────────────
# The real venv lives outside the repo (see CLAUDE.md), but guard
# against one being created in-tree by accident — an in-project
# .venv breaks the pipecat CLI via nltk's inisec.py CWD check.
.venv/
venv/
env/
ENV/

# ─── Tooling caches ─────────────────────────────────────────
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# ─── Broker: task store ─────────────────────────────────────
broker/tasks.db
broker/tasks.db-journal
broker/tasks.db-wal
broker/tasks.db-shm

# ─── Hermes task workspaces ─────────────────────────────────
# Every dispatched task gets its own directory here holding
# result.md, usage.json, and whatever files the task produced.
# Keep the workspace rules, ignore the run artifacts.
hermes-tasks/*
!hermes-tasks/AGENTS.md
!hermes-tasks/.gitkeep

# ─── Pipecat eval artifacts ─────────────────────────────────
*.eval.log
*.debug.log
eval-runs/

# ─── Debug artifacts ────────────────────────────────────────
docker-events.log

# ─── Editors / OS ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
